{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_id": "SCHEMA-EXPERIMENTAL-SOURCE-V1.1",
  "version": "1.1.0",
  "title": "Experimental Source and Evidence Provenance JSON Schema (Amended V1.1)",
  "type": "object",
  "required": [
    "claim_id",
    "stage",
    "run_id",
    "dataset",
    "split_id",
    "execution_code_commit_sha",
    "execution_code_branch",
    "execution_code_dirty",
    "protocol_version",
    "protocol_sha256",
    "command_executed",
    "environment",
    "metrics_artifact_path",
    "metrics_artifact_sha256",
    "test_firewall_state",
    "evidence_class",
    "claim_scope"
  ],
  "properties": {
    "claim_id": { "type": "string" },
    "stage": { "type": "string", "enum": ["STAGE_A1", "STAGE_A2", "STAGE_B", "STAGE_C", "PREEXECUTION_AUDIT"] },
    "run_id": { "type": "string" },
    "dataset": { "type": "string" },
    "split_id": { "type": "string" },
    "seed": { "type": ["integer", "null"] },
    "execution_code_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "execution_code_branch": { "type": "string" },
    "execution_code_dirty": { "type": "boolean" },
    "protocol_version": { "type": "string" },
    "protocol_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "graph_contract_sha256": { "type": ["string", "null"] },
    "raw_to_graph_mapping_sha256": { "type": ["string", "null"] },
    "raw_dataset_sha256": { "type": ["string", "null"] },
    "selected_train_membership_sha256": { "type": ["string", "null"] },
    "selected_val_membership_sha256": { "type": ["string", "null"] },
    "command_executed": { "type": "string" },
    "working_directory": { "type": "string" },
    "timestamp_start": { "type": "string" },
    "timestamp_end": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["python_version", "platform"],
      "properties": {
        "python_version": { "type": "string" },
        "pytorch_version": { "type": ["string", "null"] },
        "cuda_version": { "type": ["string", "null"] },
        "device_name": { "type": ["string", "null"] },
        "platform": { "type": "string" }
      }
    },
    "stdout_log_path": { "type": "string" },
    "stdout_log_sha256": { "type": "string" },
    "metrics_artifact_path": { "type": "string" },
    "metrics_artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checkpoint_path": { "type": ["string", "null"] },
    "checkpoint_sha256": { "type": ["string", "null"] },
    "test_firewall_state": {
      "type": "object",
      "required": ["test_opened", "test_feature_reads", "test_label_reads", "test_metrics"],
      "properties": {
        "test_opened": { "type": "boolean", "const": false },
        "test_feature_reads": { "type": "integer", "const": 0 },
        "test_label_reads": { "type": "integer", "const": 0 },
        "test_metrics": { "type": "integer", "const": 0 }
      }
    },
    "evidence_class": {
      "type": "string",
      "enum": ["REAL_EMPIRICAL", "PREEXECUTION_AUDIT", "NON_EMPIRICAL_TEST_FIXTURE"]
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "PRETRAINING_EMPIRICAL",
        "DOWNSTREAM_EXPLORATORY",
        "CONFIRMATORY_EVALUATION",
        "PREEXECUTION_AUDIT",
        "NON_EMPIRICAL_TEST_FIXTURE"
      ]
    }
  }
}
