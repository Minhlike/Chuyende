# Workspace Configuration
RESEARCH_WORKSPACE_ROOT=D:\Research
RESEARCH_ENVIRONMENT=development
RESEARCH_LOG_LEVEL=INFO

# Database Configuration
RESEARCH_DB_PATH=runtime\db\research.db

# Storage Directories (Relative to Workspace Root or Absolute)
RESEARCH_SPECS_DIR=research_specs
RESEARCH_SOURCES_DIR=sources
RESEARCH_DATASETS_DIR=datasets
RESEARCH_EXPERIMENTS_DIR=experiments
RESEARCH_ARTIFACTS_DIR=artifacts
RESEARCH_MEMORY_DIR=memory
RESEARCH_RUNTIME_DIR=runtime

# Execution & Guard Settings
STRICT_PATH_GUARD=true
ALLOW_DERIVED_INDEX_PURGE=true
